{
  "manifest_version": 3,
  "name": "Naver Focus",
  "short_name": "Naver Focus",
  "version": "9.1.1.2026",
  "description": "네이버 뉴스·댓글·화면을 사용자가 원하는 방식으로 정리하는 개인화 확장 프로그램",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.naver.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "Naver Focus",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "src/ui/options/options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/48.png"
      ],
      "matches": [
        "https://naver.com/*",
        "https://*.naver.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.naver.com/*",
        "https://naver.com/*",
        "https://news.naver.com/*",
        "https://n.news.naver.com/*",
        "https://media.naver.com/*",
        "https://m.news.naver.com/*",
        "https://search.naver.com/*",
        "https://m.search.naver.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/core/constants.js",
        "src/core/storage.js",
        "src/core/keyword-matcher.js",
        "src/core/dom-bus.js",
        "src/core/ui.js",
        "src/cleaner/junk-links.js",
        "src/cleaner/area-picker.js",
        "src/comments/comment-model.js",
        "src/comments/comment-blocker.js",
        "src/news/news-dom.js",
        "src/news/article-scan.js",
        "src/news/article-guard.js",
        "src/news/news-filter.js",
        "src/home/focus-home.js",
        "src/content-entry.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "css": [
        "src/home/google-results.css"
      ],
      "js": [
        "src/core/constants.js",
        "src/core/storage.js",
        "src/home/google-results-dom.js",
        "src/home/google-results.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
